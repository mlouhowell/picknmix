---
// figma 5:2 Corner Ornament; landing corners 3:701 TL, 3:941 TR, 3:781 BL, 3:861 BR (flush to the edges).
// One SVG file (OPEN: still being refined), inlined so it takes --color-brand via currentColor, flipped per corner.
// Swap the art by replacing assets/ornament/corner-ornament-traced.svg.
import { readFileSync } from 'node:fs';
const svg = readFileSync('assets/ornament/corner-ornament-traced.svg', 'utf8')
  .replace(/fill="#[0-9a-fA-F]{3,8}"/g, 'fill="currentColor"')
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const corners = [
  { pos: 'tl', figma: '3:701' },
  { pos: 'tr', figma: '3:941' },
  { pos: 'bl', figma: '3:781' },
  { pos: 'br', figma: '3:861' },
];
---
<div class="ornaments" aria-hidden="true" data-figma="5:2">
  {corners.map((c) => <div class:list={['corner', c.pos]} data-figma={c.figma} set:html={svg} />)}
</div>

<style>
  .ornaments { position: fixed; inset: 0; pointer-events: none; color: var(--color-brand); }
  .corner {
    position: absolute;
    inline-size: calc(var(--ornament-size-canvas) * var(--canvas-unit));
    aspect-ratio: 1;
  }
  .corner :global(svg) { inline-size: 100%; block-size: 100%; }
  .tl { top: 0; left: 0; }
  .tr { top: 0; right: 0; scale: -1 1; }
  .bl { bottom: 0; left: 0; scale: 1 -1; }
  .br { bottom: 0; right: 0; scale: -1 -1; }
</style>
