---
// figma 5:2 Corner Ornament; landing corners 3:701 TL, 3:941 TR, 3:781 BL, 3:861 BR (flush to the edges).
// Figma's vector (3:781, exported read-only) is drawn for the bottom-left corner; the other corners ROTATE it
// (not mirror), exactly as 3:679 does. Inlined so it takes --color-brand via currentColor.
// Swap the art by replacing assets/ornament/corner-ornament-3-781.svg.
// contained: frame the nearest positioned ancestor (landing grid intro) instead of the viewport.
import { readFileSync } from 'node:fs';
interface Props { contained?: boolean }
const { contained = false } = Astro.props;
const svg = readFileSync('assets/ornament/corner-ornament-3-781.svg', 'utf8')
  .replace(/fill="#[0-9a-fA-F]{3,8}"/g, 'fill="currentColor"')
  .replace(/\s(width|height|style|preserveAspectRatio|overflow)="[^"]*"/g, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const corners = [
  { pos: 'tl', figma: '3:701' },
  { pos: 'tr', figma: '3:941' },
  { pos: 'bl', figma: '3:781' },
  { pos: 'br', figma: '3:861' },
];
---
<div class:list={['ornaments', { contained }]} aria-hidden="true" data-figma="5:2">
  {corners.map((c) => <div class:list={['corner', c.pos]} data-figma={c.figma} set:html={svg} />)}
</div>

<style>
  .ornaments { position: fixed; inset: 0; z-index: 1; pointer-events: none; color: var(--color-brand); } /* frames the landing candies */
  .ornaments.contained { position: absolute; z-index: 0; }
  .corner {
    --ow: calc(var(--ornament-w-canvas) * var(--canvas-unit));
    --oh: calc(var(--ornament-h-canvas) * var(--canvas-unit));
    position: absolute; inline-size: var(--ow); block-size: var(--oh);
  }
  /* the svg keeps its own (unrotated) box and turns inside the corner's bounding box */
  .corner :global(svg) {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    inline-size: var(--ow); block-size: var(--oh); rotate: var(--rot, 0deg); }
  .tl, .br { inline-size: var(--oh); block-size: var(--ow); }
  .tl { top: 0; left: 0; --rot: 90deg; }
  .tr { top: 0; right: 0; --rot: 180deg; }
  .bl { bottom: 0; left: 0; }
  .br { bottom: 0; right: 0; --rot: -90deg; }
</style>
