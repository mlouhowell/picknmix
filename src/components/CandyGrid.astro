---
// figma 109:44 Grid (landing 109:27; phones 109:234): just the candy cut-outs on the page background, no captions,
// no tile background. 5 per row on desktop. The 13 candies of content/grid/candies.json repeat in order; the first
// `copies` sets are rendered here and scripts/landing-grid.ts keeps appending sets as you scroll (never-ending).
// Each candy is a button that opens the drawer (CandyDrawer.astro). Repeats are hidden from assistive tech.
import Picture from './Picture.astro';
import { gridCandies, gridSrc } from '../lib/content';

const copies = 4;
const cols = 5;
const tileW = 230; // CSS px of a tile at 1440 (109:46)
const items = Array.from({ length: copies }, (_, k) => gridCandies.map((c, i) => ({ c, i, repeat: k > 0 }))).flat();
---
<!-- figma 109:44 Grid, tiles 109:46 ff. (frame 109:47 p 12, candy image 109:48) -->
<ul class="candy-grid" data-figma="109:44" data-endless>
  {items.map(({ c, i, repeat }, n) => (
    <li aria-hidden={repeat ? 'true' : undefined}>
      <button type="button" class="tile" data-index={i} tabindex={repeat ? -1 : undefined} data-figma="109:47">
        <Picture src={gridSrc(c)} alt={c.name} displayWidth={tileW} sizes={`(max-width: 40em) 45vw, ${tileW}px`} eager={n < cols} figma="109:48" />
      </button>
    </li>
  ))}
</ul>
<div class="sentinel" aria-hidden="true" data-endless-sentinel></div>

<style>
  .candy-grid {
    margin: 0 auto; padding: 0 var(--grid-gutter) var(--grid-pad-bottom);
    max-inline-size: calc(var(--grid-max-w) + 2 * var(--grid-gutter));
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: var(--grid-col-gap); row-gap: var(--grid-row-gap);
  }
  @media (max-width: 64em) { .candy-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 48em) { .candy-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 40em) { .candy-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .tile {
    display: block; inline-size: 100%; padding: var(--grid-tile-pad);
    border: 0; background: none; cursor: pointer;
  }
  .tile :global(picture) { display: block; aspect-ratio: var(--grid-img-ratio); }
  .tile :global(img) {
    inline-size: 100%; block-size: 100%; object-fit: contain; object-position: center;
    transition: scale var(--duration-page) var(--ease-out);
  }
  .tile:hover :global(img), .tile:focus-visible :global(img) { scale: var(--landing-tile-hover-scale); }
  .sentinel { block-size: var(--hairline); }
</style>
