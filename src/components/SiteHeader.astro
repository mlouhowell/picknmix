---
// figma 179:291 Header: logo left, Grid / Timeline text links right (179:294); the current view is ink + underlined.
// Same row on phones. The links switch views in scripts/landing-grid.ts (aria-pressed + ?view=).
import { site } from '../lib/content';
---
<header class="site-header" data-figma="179:291">
  <!-- figma 179:292 Logo: "Pick N Mix" (no tagline, owner 2026-10-23) -->
  <p class="logo" data-figma="179:292">
    <span class="name" data-figma="180:360">{site.siteName}</span>
  </p>
  <!-- figma 179:294 Nav links: Grid 179:295 / Timeline 179:296 -->
  <div class="view-nav" role="group" aria-label={site.header.viewLabel} data-figma="179:294">
    <button type="button" class="link" data-view="grid" aria-pressed="true" data-figma="179:295">{site.header.grid}</button>
    <button type="button" class="link" data-view="timeline" aria-pressed="false" data-figma="179:296">{site.header.timeline}</button>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    min-block-size: var(--header-h); padding: var(--header-pad-block) var(--header-pad-inline);
    background: var(--color-page);
  }
  .logo { display: flex; align-items: baseline; gap: var(--space-logo-gap); white-space: nowrap; line-height: normal; }
  .name {
    font-family: var(--font-display); font-variation-settings: var(--font-display-variation);
    font-size: var(--type-logo-size); font-weight: var(--type-candy-title-weight); color: var(--color-ink);
  }
  .view-nav { display: flex; gap: var(--nav-gap); padding: var(--nav-pad-block) var(--nav-pad-inline); }
  .link {
    border: 0; padding: 0; background: none; cursor: pointer;
    font-family: var(--font-ui); font-size: var(--type-nav-size); font-weight: var(--type-nav-weight);
    line-height: var(--type-nav-leading); white-space: nowrap;
    color: var(--color-text-muted);
    text-underline-offset: var(--nav-underline-offset);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .link:hover { color: var(--color-ink); }
  .link[aria-pressed='true'] { color: var(--color-ink); text-decoration: underline; }

  @media (max-width: 40em) {
    .site-header { padding-inline: var(--grid-gutter); }
    .view-nav { padding-inline: 0; }
  }
</style>
