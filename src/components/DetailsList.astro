---
// figma 8:222 Details (stacked: label 130 | value 229, rows 27 tall). 'row' variant = BUBS 8:151 (OPEN, site.json switch).
import type { Candy } from '../lib/schema';
import { site } from '../lib/content';
interface Props { candy: Candy }
const { candy } = Astro.props;
const { labels, detailsHeading, layout } = site.candyPage;
const rows = [
  { label: labels.year, value: candy.year, figma: '8:224' },
  { label: labels.type, value: candy.type, figma: '8:227' },
  ...(layout.showMaker ? [{ label: labels.maker, value: candy.maker, figma: '8:151' }] : []),
];
---
<section class:list={['details', layout.details]} data-figma={layout.details === 'row' ? '8:151' : '8:222'} aria-labelledby="details-heading">
  <h2 id="details-heading" class:list={['section-heading', { 'visually-hidden': layout.details === 'row' }]} data-figma="8:223">{detailsHeading}</h2>
  <dl>
    {rows.map((r) => (
      <div class="row" data-figma={r.figma}>
        <dt>{r.label}</dt>
        <dd>{r.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .section-heading { font-size: var(--type-section-size); font-weight: var(--type-section-weight); line-height: var(--type-section-leading); }
  dt { font-size: var(--type-label-size); font-weight: var(--type-label-weight); color: var(--color-text-muted); }
  dd { font-size: var(--type-value-size); }
  dt, dd { line-height: var(--type-detail-leading); }
  /* stacked (8:222) */
  .stacked .row { display: grid; grid-template-columns: var(--detail-label-w) minmax(0, var(--detail-value-w)); column-gap: var(--space-detail-col); }
  /* row (8:151, OPEN) */
  .details.row dl { display: flex; }
  .details.row .row { inline-size: var(--detail-row-col-w); }
  .details.row .row + .row { margin-inline-start: var(--space-detail-col); }
</style>
