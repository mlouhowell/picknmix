---
// Blurred candy collage (landing 3:679 slots from content/landing-layout.json). Positioned in % of a
// canvas-ratio stage. fit="contain" = landing (stage fits the viewport), "cover" = behind candy pages.
// Slots without a src are skipped. Children render inside the stage (landing title), positioned in the same canvas %.
// Motion (landing.motion): each candy spins slowly in place and drifts nearer/farther (scale). Durations are
// staggered per slot and directions alternate so the collage never moves in lockstep; at t=0 every slot sits
// exactly at its Figma pose. Off under prefers-reduced-motion.
// links (landing): slots with linksTo become links to that candy page; hover/focus brings the candy into focus
// (no blur, full opacity) and holds it still so it's easy to click. Behind candy pages the collage stays decorative.
// Landing only: scripts/landing-scroll.ts stirs the slots on scroll via --sy / --sr (depth: sharp = near = most).
import Picture from './Picture.astro';
import { landing, site, getCandy, candyHref } from '../lib/content';
import { hasImg } from '../lib/img';
interface Props { fit?: 'contain' | 'cover'; includeHero?: boolean; links?: boolean }
const { fit = 'cover', includeHero = false, links = false } = Astro.props;
const slots = [
  ...landing.blurredCandies.map((s) => ({ ...s, sharp: false })),
  ...(includeHero ? [{ ...landing.sharpHero, blurPx: 0, opacity: 1, sharp: true }] : []),
].filter((s) => hasImg(s.src));
const m = landing.motion;
const frac = (i: number, k: number) => (i * k) % 1; // deterministic per-slot variation
const motionVars = (s: (typeof slots)[number], i: number) =>
  `--spin:${s.spinSeconds ?? +(m.spinSeconds * (0.75 + frac(i, 0.37) / 2)).toFixed(2)}s;` +
  `--dir:${i % 2 ? -1 : 1};` +
  `--depth:${s.depthSeconds ?? +(m.depthSeconds * (0.8 + frac(i, 0.29) * 0.4)).toFixed(2)}s;` +
  `--near:${m.scaleNear};--far:${m.scaleFar}`;
const link = (slug: string | null) => {
  if (!links || !slug) return null;
  const c = getCandy(slug);
  return { href: candyHref(c), label: site.landing.candyLinkLabel.replace('{name}', c.name) };
};
const maxBlur = Math.max(...slots.map((s) => s.blurPx), 1);
const depthOf = (blur: number) => +(1 - 0.75 * (blur / maxBlur)).toFixed(3); // 1 = sharp/near, 0.25 = most blurred
const stir = links ? JSON.stringify({ travel: m.scrollTravel, spin: m.scrollSpinDeg, sensitivity: m.scrollSensitivity, returnPerSecond: m.scrollReturnPerSecond }) : undefined;
const px = (pct: number, of: number) => Math.round((pct / 100) * of);
---
<div class:list={['stage', fit]} data-figma="3:679" data-scroll-stir={stir} transition:persist={fit === 'cover' ? 'candy-background' : undefined}>
  <div class="slots" aria-hidden={links ? undefined : 'true'}>
  {slots.map((s, i) => {
    const l = link(s.linksTo);
    const Tag = l ? 'a' : 'div';
    return (
      <Tag class:list={['slot', { sharp: s.sharp, link: !!l }]} data-figma={s.figmaNode}
        href={l?.href} aria-label={l?.label} aria-hidden={l ? undefined : 'true'}
        data-depth={depthOf(s.blurPx)} data-dir={i % 2 ? -1 : 1}
        style={`--l:${s.leftPct}%;--t:${s.topPct}%;--w:${s.widthPct}%;--h:${s.heightPct}%;--r:${s.rotateDeg}deg;--blur:${s.blurPx};--o:${s.opacity};${motionVars(s, i)}`}>
        <div class="depth"><div class="spin">
          <Picture src={s.src!} alt="" displayWidth={px(s.widthPct, landing.canvas.w)} />
        </div></div>
      </Tag>
    );
  })}
  </div>
  <slot />
</div>

<style>
  .stage {
    position: fixed; left: 50%; top: 50%; translate: -50% -50%;
    aspect-ratio: var(--canvas-ratio);
    container-type: inline-size;
  }
  .slots { position: absolute; inset: 0; pointer-events: none; }
  .stage.cover { inline-size: max(100vw, 100vh * var(--canvas-ratio)); }
  .stage.contain { inline-size: min(100vw, 100vh * var(--canvas-ratio)); }
  .slot {
    position: absolute; left: var(--l); top: var(--t); inline-size: var(--w); block-size: var(--h);
    rotate: calc(var(--r) + var(--sr, 0deg)); opacity: var(--o);
    translate: 0 calc(var(--sy, 0) * 100cqw / var(--canvas-w-unitless)); /* scroll stir, canvas px */
    /* blur is in canvas px; scale it with the stage */
    filter: blur(calc(var(--blur) * 100cqw / var(--canvas-w-unitless)));
  }
  .slot.sharp { filter: none; }
  .slot.link {
    pointer-events: auto; cursor: pointer;
    transition: filter var(--duration-page) var(--ease-out), opacity var(--duration-page) var(--ease-out);
  }
  .slot.link:hover, .slot.link:focus-visible { filter: none; opacity: 1; }
  .slot.link:hover *, .slot.link:focus-visible * { animation-play-state: paused; }
  .depth, .spin { inline-size: 100%; block-size: 100%; }
  .slot :global(picture), .slot :global(img) { display: block; inline-size: 100%; block-size: 100%; object-fit: contain; }
  @media (prefers-reduced-motion: no-preference) {
    .spin { animation: candy-spin var(--spin) linear infinite; }
    .depth { animation: candy-depth var(--depth) ease-in-out infinite; }
    .slot:nth-child(even) .depth { animation-direction: reverse; } /* half drift away first */
  }
  @keyframes candy-spin { from { rotate: 0turn; } to { rotate: calc(var(--dir) * 1turn); } }
  /* starts and ends at the Figma size; nearer (bigger) then farther (smaller) */
  @keyframes candy-depth { 0%, 100% { scale: 1; } 25% { scale: var(--near); } 75% { scale: var(--far); } }
</style>
