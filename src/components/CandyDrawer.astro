---
// figma 147:1415 Candy page · Side drawer template, as an overlay (no 3D). Stage 147:1467: the page behind under a
// 60% page-colour scrim with a 17px blur (147:1477), the candy cut-out 512 centred (Hero 147:1481). Side drawer
// 147:1416 on the right: close + next (147:1417), handwritten title + body (147:1424), Details rows (147:1429).
// One panel + hero per candy in content/grid/candies.json; scripts/landing-grid.ts shows the current one. Empty text
// fields are left out (copy coming). Similar Candies (147:1438) is not shown yet: the grid candies have no variants.
import IconButton from './IconButton.astro';
import Picture from './Picture.astro';
import { site, gridCandies, gridSrc, timeline } from '../lib/content';

const eraName = (id: string) => {
  const e = timeline.eras.find((x) => x.id === id);
  return e ? `${e.dates} · ${e.title}` : '';
};
const heroW = 512; // = --hero-size (147:1481)
const f = site.drawer.fields;
---
<dialog class="drawer" aria-label={site.drawer.label} data-drawer data-figma="147:1415">
  <div class="layout">
    <!-- figma 147:1467 stage: hero 147:1481 -->
    <div class="hero-area" data-hero-area data-figma="147:1467">
      {gridCandies.map((c, i) => (
        <figure class="hero" data-hero={i} hidden data-figma="147:1481">
          <Picture src={gridSrc(c)} alt={c.name} displayWidth={heroW} sizes={`(max-width: 48em) 70vw, ${heroW}px`} />
          {c.caption && <figcaption>{c.caption}</figcaption>}
        </figure>
      ))}
    </div>

    <!-- figma 147:1416 side drawer -->
    <aside class="panel" data-figma="147:1416">
      <!-- figma 147:1417 drawer controls -->
      <div class="controls" data-figma="147:1417">
        <IconButton label={site.drawer.close} icon="close" figma="147:1418" nav="close" />
        <IconButton label={site.drawer.next} icon="next" figma="147:1421" nav="next" />
      </div>
      <!-- figma 147:1423 content, one per candy -->
      {gridCandies.map((c, i) => {
        const rows = [
          { label: f.year, value: c.year, figma: '147:1432' },
          { label: f.type, value: c.type, figma: '147:1435' },
          { label: f.era, value: eraName(c.era), figma: '147:1432' },
        ].filter((r) => r.value);
        return (
          <article class="content" data-panel={i} hidden data-figma="147:1423">
            <div class="title-block" data-figma="147:1424">
              <h2 class="title" data-figma="147:1426">{c.name}</h2>
              {c.body && <p class="body" data-figma="147:1428">{c.body}</p>}
            </div>
            {rows.length > 0 && (
              <section class="details" aria-labelledby={`details-${c.slug}`} data-figma="147:1429">
                <h3 class="heading" id={`details-${c.slug}`} data-figma="147:1430">{site.drawer.detailsHeading}</h3>
                <dl>
                  {rows.map((r) => (
                    <div class="row" data-figma={r.figma}><dt>{r.label}</dt><dd>{r.value}</dd></div>
                  ))}
                </dl>
              </section>
            )}
          </article>
        );
      })}
    </aside>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed; inset: 0; margin: 0; padding: 0; border: 0;
    inline-size: 100vw; block-size: 100dvh; max-inline-size: none; max-block-size: none;
    background: transparent; color: var(--color-ink); overflow: hidden;
  }
  /* figma 147:1477 Scrim 60%: page colour at 60% + 17px blur over the grid / timeline */
  .drawer::backdrop {
    background: var(--drawer-scrim);
    backdrop-filter: blur(var(--drawer-blur)); -webkit-backdrop-filter: blur(var(--drawer-blur));
  }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) var(--drawer-w); block-size: 100%; }

  .hero-area { display: grid; place-items: center; padding: var(--drawer-pad); cursor: zoom-out; }
  .hero { margin: 0; inline-size: var(--hero-size); max-inline-size: 100%; display: grid; gap: var(--space-stack); cursor: auto; }
  .hero[hidden], .content[hidden] { display: none; }
  .hero :global(picture) { display: block; aspect-ratio: 1; }
  .hero :global(img) { inline-size: 100%; block-size: 100%; object-fit: contain; }
  .hero figcaption { text-align: center; font-family: var(--font-ui); font-size: var(--type-caption-size); color: var(--color-text-muted); }

  .panel {
    display: flex; flex-direction: column; gap: var(--drawer-gap);
    padding: var(--drawer-pad) var(--drawer-pad) var(--drawer-pad-bottom);
    background: var(--color-panel); border-inline-start: var(--hairline) solid var(--color-line);
    overflow-y: auto;
  }
  .controls { display: flex; align-items: center; justify-content: space-between; }
  .controls :global(.icon-button) {
    inline-size: var(--drawer-button); block-size: var(--drawer-button);
    background: var(--color-toggle); color: var(--color-ink);
  }
  .content { display: flex; flex-direction: column; gap: var(--drawer-gap); }
  .title-block { display: flex; flex-direction: column; gap: var(--space-stack); }
  .title { font-family: var(--font-hand); font-weight: normal; font-size: var(--type-drawer-title-size); line-height: normal; }
  .body { font-family: var(--font-body); font-size: var(--type-body-size); line-height: var(--type-body-leading); }
  .details { display: flex; flex-direction: column; gap: var(--space-stack); line-height: normal; }
  .heading { font-family: var(--font-body); font-size: var(--type-drawer-heading-size); font-weight: var(--type-section-weight); }
  .row {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-stack);
    padding-block: var(--drawer-row-pad); border-block-start: var(--hairline) solid var(--color-line);
    font-family: var(--font-body);
  }
  dt { font-size: var(--type-drawer-label-size); color: var(--color-text-muted); }
  dd { font-size: var(--type-drawer-value-size); text-align: end; }

  /* the drawer slides in from the right, the candy fades in (tokens are 0ms under reduced motion) */
  .drawer[open] .panel { animation: panel-in var(--duration-page) var(--ease-out); }
  .drawer[open] .hero-area { animation: fade-in var(--duration-page) var(--ease-out); }
  @keyframes panel-in { from { translate: 100% 0; } }
  @keyframes fade-in { from { opacity: 0; } }

  /* phones: candy on top, drawer underneath, the whole overlay scrolls; controls stay at the top */
  @media (max-width: 48em) {
    .drawer { overflow-y: auto; }
    .layout { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; block-size: auto; min-block-size: 100%; }
    .hero { inline-size: min(var(--hero-size), 70vw); }
    .panel { overflow: visible; border-inline-start: 0; border-block-start: var(--hairline) solid var(--color-line); }
    .controls { position: fixed; inset-block-start: var(--drawer-pad); inset-inline: var(--drawer-pad); z-index: 1; }
    .drawer[open] .panel { animation-name: fade-in; }
  }
</style>
