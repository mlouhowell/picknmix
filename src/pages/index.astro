---
// Landing, figma 3:679 (chosen; 10:11 / 10:155 / 3:226 are explorations, not built).
// Composition from content/landing-layout.json (mode: "universe" fly-through or the "collage" of 3:679);
// copy from content/site.json. Each candy links to its page.
import Base from '../layouts/Base.astro';
import BackgroundCandies from '../components/BackgroundCandies.astro';
import CandyUniverse from '../components/CandyUniverse.astro';
import CandyGrid from '../components/CandyGrid.astro';
import CornerOrnaments from '../components/CornerOrnaments.astro';
import { site, landing } from '../lib/content';
---
<Base description={`${site.landing.eyebrow} ${site.landing.title}`}>
  <main class:list={['landing', landing.mode]} data-figma="3:679">
    {landing.mode === 'grid' && (
      <>
        {landing.grid.intro ? (
          <header class="intro">
            <!-- figma 3:1021 title group (eyebrow 3:690 + title 3:689) -->
            <hgroup class="title-group" data-figma={landing.title.figmaNode} style="--cy:50%">
              <p class="eyebrow" data-figma="3:690">{site.landing.eyebrow}</p>
              <h1 class="title" data-figma="3:689">{site.landing.title}</h1>
            </hgroup>
            <CornerOrnaments contained />
          </header>
        ) : (
          <h1 class="visually-hidden" data-figma="3:689">{site.landing.eyebrow} {site.landing.title}</h1>
        )}
        <CandyGrid />
      </>
    )}
    {landing.mode === 'universe' ? (
      <CandyUniverse>
        <!-- figma 3:1021 title group (eyebrow 3:690 + title 3:689), vertically centred -->
        <hgroup class="title-group" data-figma={landing.title.figmaNode} style={`--cy:${landing.title.centerYPct}%`}>
          <p class="eyebrow" data-figma="3:690">{site.landing.eyebrow}</p>
          <h1 class="title" data-figma="3:689">{site.landing.title}</h1>
        </hgroup>
      </CandyUniverse>
    ) : landing.mode === 'collage' ? (
      <BackgroundCandies fit="contain" includeHero links>
        <!-- figma 3:1021 title group (eyebrow 3:690 + title 3:689), vertically centred -->
        <hgroup class="title-group" data-figma={landing.title.figmaNode} style={`--cy:${landing.title.centerYPct}%`}>
          <p class="eyebrow" data-figma="3:690">{site.landing.eyebrow}</p>
          <h1 class="title" data-figma="3:689">{site.landing.title}</h1>
        </hgroup>
      </BackgroundCandies>
    ) : null}
    {landing.mode !== 'grid' && <CornerOrnaments />}
  </main>
</Base>

<script>
  import '../scripts/landing-scroll';
  import '../scripts/landing-universe';
</script>

<style>
  .landing {
    /* 1 canvas px, so the collage + ornaments scale with the viewport like the 1400x1038 frame */
    --canvas-unit: min(100vw / var(--canvas-w-unitless), 100vh / var(--canvas-h-unitless));
    min-block-size: 100vh; min-block-size: 100dvh;
    overflow: hidden;
  }
  .landing.grid { overflow: visible; padding-block-start: var(--space-landing-grid-top); } /* scrolls like a normal page */
  .landing.grid:has(.intro) { padding-block-start: 0; }
  .intro { position: relative; block-size: var(--landing-grid-intro-h); }
  .title-group {
    position: absolute; left: 50%; top: var(--cy); translate: -50% -50%;
    display: grid; justify-items: center; gap: calc(var(--space-eyebrow-title) - var(--landing-eyebrow-leading));
    text-align: center; inline-size: var(--landing-title-w); max-inline-size: 90vw;
    pointer-events: none; /* candies behind the title stay clickable */
  }
  .eyebrow { font-size: var(--type-eyebrow-size); line-height: var(--landing-eyebrow-leading); }
  .title {
    font-family: var(--font-display); font-variation-settings: var(--font-display-variation);
    font-size: var(--type-hero-title-size); font-weight: var(--type-hero-title-weight);
    letter-spacing: var(--type-hero-title-tracking); line-height: var(--type-hero-title-leading);
    color: var(--color-brand);
  }
</style>
